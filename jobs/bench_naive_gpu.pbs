#!/bin/bash
#PBS -q gpu
#PBS -l select=1:ncpus=2:ngpus=1
#PBS -l walltime=00:10:00
#PBS -N bench_naive

set -euo pipefail

# Log manuale (robusto: PBS non tiene history)
LOG="/home/u10905938/bench_naive_${PBS_JOBID}.log"
exec > >(tee -a "$LOG") 2>&1

echo "=== BENCH NAIVE START ==="
date
echo "JOBID=$PBS_JOBID"
echo "HOST=$(hostname)"
echo "WORKDIR=$PBS_O_WORKDIR"

cd "$PBS_O_WORKDIR"

# ambiente CUDA
source /software/spack-v1.0/share/spack/setup-env.sh
spack load cuda

# cartelle output
mkdir -p data/results
mkdir -p plots

echo "[1/4] Compile benchmark_test"
nvcc -O3 -std=c++17 -Iinclude -arch=sm_89 \
  bench/micro/benchmark_test.cu \
  src/backends/cuda/gemm_cuda_naive.cu \
  -o benchmark_test

echo "[2/4] Quick correctness check (small)"
# Esegue un test piccolo e veloce (se implementi --check; vedi sotto)
./benchmark_test naive float --check 256

echo "[3/4] Run benchmark -> CSV"
CSV="data/results/naive_float_${PBS_JOBID}.csv"
./benchmark_test naive float --min 256 --max 4096 --step 256 --reps 20 --warmup 5 \
  >"$CSV"

echo "Saved CSV: $CSV"
head -n 5 "$CSV" || true

echo "[4/4] Plot (PDF)"
python3 scripts/plot/plot_results.py "$CSV"

echo "=== DONE ==="
date
echo "Log: $LOG"

###  cd ~/AlpaScalata
###  . /etc/profile.d/pbs.sh
###  qsub jobs/bench_naive_gpu.pbs
